+     * For the ISO calendar system, it is equal to 7 days.
+     * <p>
+     * When used with other calendar systems it must correspond to an integral number of days.
+     */
+    WEEKS("Weeks", Duration.ofSeconds(7 * 86400L)),
+    /**
