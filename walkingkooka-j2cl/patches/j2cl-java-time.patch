+    }
+
+    //-------------------------------------------------------------------------
+    /**
+     * Constructor.
+     *
+     * @param id  the time-zone ID, not null
+     * @param rules  the rules, null for lazy lookup
+     */
+    ZoneRegion(String id, ZoneRules rules) {
+        this.id = id;
+        this.rules = rules;
+    }
+
+    //-----------------------------------------------------------------------
+    @Override
+    public String getId() {
