+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ */
+
+package walkingkooka.collect.list;
+
+import walkingkooka.collect.iterator.Iterators;
+
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * A {@link List} known to be immutable and holds a copy of any {@link List} given to it.
+ */
+final class ImmutableListImplSingleton<T> extends ImmutableListImpl<T> {
+
+    /**
+     * Returns a {@link List} which is immutable.
+     */
+    static <T> ImmutableListImplSingleton<T> withElement(final T element) {
+        return new ImmutableListImplSingleton<>(element);
+    }
+
+    /**
+     * Private ctor use factory
+     */
+    private ImmutableListImplSingleton(final T element) {
+        super();
+        this.element = element;
+    }
+
+    @Override
+    public boolean contains(final Object other) {
+        return Objects.equals(
+            this.element,
+            other
+        );
+    }
+
+    @Override
+    public T get(final int index) {
+        if (index != 0) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds size=1");
+        }
+        return this.element;
+    }
+
+    @Override
+    public Iterator<T> iterator() {
+        return Iterators.one(this.element);
+    }
+
+    @Override
+    public int size() {
+        return 1;
+    }
+
+    @Override
+    public boolean isEmpty() {
+        return false;
+    }
+
+    @Override
+    public String toString() {
+        return "[" + this.element + "]";
+    }
+
+    private final T element;
+}
diff --git a/jre/java/walkingkooka/collect/list/Lists.java b/jre/java/walkingkooka/collect/list/Lists.java
