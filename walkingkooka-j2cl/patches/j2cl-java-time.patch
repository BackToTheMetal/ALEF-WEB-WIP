+        calendar.add(Calendar.YEAR, -80);
+        tzId = calendar.getTimeZone().getID();
+        creationYear = calendar.get(Calendar.YEAR);
+        defaultCenturyStart = calendar.getTime();
+
+        this.locale = locale;
+    }
