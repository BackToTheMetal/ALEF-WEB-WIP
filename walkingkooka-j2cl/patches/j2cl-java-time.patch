diff --git a/jre/java/BUILD b/jre/java/BUILD
--- a/jre/java/BUILD
+++ b/jre/java/BUILD
@@ -52,7 +52,7 @@
 )
 
 BASE_JRE_SRCS = glob(
-    ["java*/**/*.java"],
+    ["java*/**/*.java", "walkingkooka/**/*.java"],
     exclude = ["javaemul/internal/annotations/**"],
 ) + ["module-info.java"]
 
@@ -140,7 +140,7 @@
 # to avoid circular dependency.
 java_library(
     name = "jre_bootclasspath",
-    srcs = [":jre_java_files"],
+    srcs = [":walkingkooka_jre_stripped"],
     javacopts = JRE_JAVAC_OPTS + DEFAULT_J2CL_JAVAC_OPTS,
     visibility = ["//transpiler/javatests/com/google/j2cl/transpiler:__pkg__"],
     deps = [
@@ -171,3 +171,13 @@
     bootclasspath = ":jre_bootclasspath-j2wasm",
     visibility = ["//build_defs:toolchain_users"],
 )
+
+# The bootclasspath java_library does not run the normal J2CL source stripper.
+# Use the official parser-based stripper before compiling these upstream sources.
+genrule(
+    name = "walkingkooka_jre_stripped",
+    srcs = [":jre_java_files"],
+    outs = ["walkingkooka_jre_stripped.srcjar"],
+    tools = ["//tools/java/com/google/j2cl/tools/gwtincompatible:GwtIncompatibleStripper"],
+    cmd = "$(location //tools/java/com/google/j2cl/tools/gwtincompatible:GwtIncompatibleStripper) -d $@.zip $(location :jre_java_files) && mv $@.zip $@",
+)
