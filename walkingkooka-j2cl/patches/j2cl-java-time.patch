+            cachedFields[3] = fields[DAY_OF_WEEK];
+            cachedFields[4] = zoneOffset;
+            cachedFields[5] = fields[ERA];
+            cachedFields[6] = fields[WEEK_OF_YEAR];
+            cachedFields[7] = fields[WEEK_OF_MONTH];
