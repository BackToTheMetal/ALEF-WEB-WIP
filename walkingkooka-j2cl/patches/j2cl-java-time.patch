+ * limitations under the License.
+ *
+ */
+
+package walkingkooka;
+
+final class ToStringBuilderAppenderScalarSharedDefault extends ToStringBuilderAppenderScalarShared<Object> {
+
+    static ToStringBuilderAppenderScalarSharedDefault with(final Object value) {
+        return new ToStringBuilderAppenderScalarSharedDefault(value);
+    }
+
+    private ToStringBuilderAppenderScalarSharedDefault(final Object value) {
+        super(value);
+        this.string = String.valueOf(value);
+    }
+
+    @Override
+    boolean isDefaultValue() {
+        final Object value = this.value;
+        return null == value ||
+            this.string.isEmpty() ||
+            (
+                value instanceof CanBeEmpty &&
+                    ((CanBeEmpty) value).isEmpty()
+            ); // null or empty or CanBeEmpty#isEmpty() may be skipped
+    }
+
+    @Override
+    void value(final ToStringBuilder builder) {
+        builder.buffer.append(this.string); // without escaping or quoting, verbatim.
+        builder.mode = builder.mode.value();
+        builder.valueFinished();
+    }
+
+    private final String string;
+}
