+    /**
+     * Escapes all newline, carriage returns and other common characters that are escaped in java by
+     * a backslash prefix. Null inputs return null.
+     */
+    public static CharSequence escape(final CharSequence chars) {
+        return null == chars ?
+            null :
+            escapeNonNull(chars);
