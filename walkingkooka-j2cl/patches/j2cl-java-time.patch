+            int offset = startOfWeekOffset(temporal.get(DAY_OF_YEAR), dow);
+            int yearLen = Year.isLeap(year) ? 366 : 365;
+            int weekIndexOfFirstWeekNextYear = computeWeek(offset, yearLen + weekDef.getMinimalDaysInFirstWeek());
