+            fields[DATE] = cachedFields[2];
+            fields[DAY_OF_WEEK] = cachedFields[3];
+            fields[ERA] = cachedFields[5];
+            fields[WEEK_OF_YEAR] = cachedFields[6];
+            fields[WEEK_OF_MONTH] = cachedFields[7];
