+        // that the provider was added after the ZoneId was created
+        return (rules != null ? rules : ZoneRulesProvider.getRules(id, false));
+    }
+
+    //-----------------------------------------------------------------------
+    @GwtIncompatible
+    private Object writeReplace() {
+        return new Ser(Ser.ZONE_REGION_TYPE, this);
+    }
+
+    /**
