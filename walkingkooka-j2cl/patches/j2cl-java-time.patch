+    }
+
+    //-----------------------------------------------------------------------
+    /**
+     * Outputs this zone as a {@code String}, using the ID.
+     *
+     * @return a string representation of this time-zone ID, not null
+     */
+    @Override
+    public String toString() {
+        return getId();
+    }
+
+    //-----------------------------------------------------------------------
+    @GwtIncompatible
+    abstract void write(DataOutput out) throws IOException;
+
