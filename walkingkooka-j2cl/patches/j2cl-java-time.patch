+        return true;
+    }
+
+    /**
+     * Short circuit future requests to simply ask the other {@link CharPredicate}.
+     */
+    public CharPredicate and(final CharPredicate other) {
+        return other;
+    }
+
+    /**
+     * The opposite of true is false
+     */
