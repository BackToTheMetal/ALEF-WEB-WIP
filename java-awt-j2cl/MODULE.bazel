module(
    name = "webawt",
    version = "0.2.0",
)

bazel_dep(name = "elemental2", version = "1.3.2")
bazel_dep(name = "j2cl", version = "20260402")
bazel_dep(name = "rules_closure", version = "0.16.0")
bazel_dep(name = "rules_jvm_external", version = "6.7", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
maven.install(
    name = "webawt_test_maven",
    artifacts = [
        "com.microsoft.playwright:playwright:1.62.0",
        "junit:junit:4.13.2",
    ],
    lock_file = "//:rules_jvm_external++maven+webawt_test_maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "webawt_test_maven")

single_version_override(
    module_name = "elemental2",
    patch_strip = 1,
    patches = ["//third_party/patches:elemental2-1.3.2-w3c-css.patch"],
    version = "1.3.2",
)

# Required by the shared Swing component/type APIs. Consumer roots repeat this override.
single_version_override(
    module_name = "j2cl", version = "20260402", patch_strip = 1,
    patches = [
        "//third_party/patches:j2cl-reflection-base.patch",
        "//third_party/patches:j2cl-type-support.patch",
        "//third_party/patches:j2cl-invocation-support.patch",
    ],
)
