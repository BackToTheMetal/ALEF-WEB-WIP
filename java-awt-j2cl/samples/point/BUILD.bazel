load("@j2cl//build_defs:rules.bzl", "j2cl_application", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")

j2cl_library(
    name = "point_sample",
    srcs = ["PointSample.java"],
    deps = [
        "//src/main/java/java/awt:awt-j2cl",
        "//src/main/java/org/webawt/internal/browser:browser-elemental2-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
    ],
)

closure_js_library(
    name = "app",
    srcs = ["app.js"],
    deps = [":point_sample"],
)

j2cl_application(
    name = "point_application",
    entry_points = ["webawt.point.app"],
    deps = [":app"],
)
