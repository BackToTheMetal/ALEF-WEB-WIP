    visibility = ["//src/test/dualshowcase/org/webawt/samples/dualshowcase:__pkg__", "//src/test/portable/com/webawt/portable:__pkg__", "//src/test/playwright/com/webawt/playwright:__pkg__"],
    deps = [
        "//src/main/java/java/awt:awt-j2cl",
        "//src/main/java/java/awt:desktop-j2cl",
        "//src/main/java/java/awt:graphics-api-j2cl",
        "//src/main/java/java/awt:image-core-j2cl",
        "//src/main/java/java/awt:image-ops-j2cl",
        "//src/main/java/java/awt:painting-j2cl",
        "//src/main/java/java/awt:font-j2cl",
        "//src/main/java/java/text:text-j2cl",
        "//src/main/java/javax/accessibility:accessibility-j2cl",
