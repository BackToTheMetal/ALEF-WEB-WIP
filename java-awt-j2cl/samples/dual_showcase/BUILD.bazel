    srcs = ["BrowserClipboardAccess.java", "BrowserLauncher.java", "BrowserDiagnostics.java"],
    deps = [
        ":shared-j2cl",
        "//src/main/java/org/webawt/internal/browser:browser-elemental2-j2cl",
        "//src/main/java/org/webawt/internal/peer:peer-api-j2cl",
        "@elemental2//:elemental2-dom-j2cl",
        "//src/main/java/java/awt:graphics-api-j2cl",
        "//src/main/java/org/webawt:webawt-j2cl",
        "@j2cl//:jsinterop-annotations-j2cl",
        "@elemental2//:elemental2-promise-j2cl",
