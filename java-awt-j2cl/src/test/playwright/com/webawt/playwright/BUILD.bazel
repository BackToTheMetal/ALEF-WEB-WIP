java_binary(
    name = "playwright_cli",
    main_class = "com.microsoft.playwright.CLI",
    runtime_deps = ["@webawt_test_maven//:com_microsoft_playwright_playwright"],
    testonly = True,
)

java_test(
    name = "WebAwtChromiumTest",
    srcs = ["WebAwtPlaywrightTest.java"],
    data = ["//samples/showcase:showcase_application"],
    env = {"WEBAWT_PLAYWRIGHT_BROWSER": "chromium"},
    size = "large",
    tags = ["no-sandbox"],
    test_class = "com.webawt.playwright.WebAwtPlaywrightTest",
    deps = [
        "@webawt_test_maven//:com_microsoft_playwright_playwright",
        "@webawt_test_maven//:junit_junit",
    ],
)

