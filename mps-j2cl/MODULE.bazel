module(name = "mps_j2cl", version = "0.1.0")

bazel_dep(name = "j2cl", version = "20260402")
bazel_dep(name = "rules_closure", version = "0.16.0")
bazel_dep(name = "gnu_trove_j2cl", version = "0.1.0")
bazel_dep(name = "org_jdom_j2cl", version = "0.1.0")
bazel_dep(name = "webawt", version = "0.2.0")
bazel_dep(name = "javax-swing-j2cl", version = "0.2.0")
bazel_dep(name = "elemental2", version = "1.3.2")

local_path_override(module_name = "gnu_trove_j2cl", path = "../gnu-trove-j2cl")
local_path_override(module_name = "org_jdom_j2cl", path = "../org-jdom-j2cl")
local_path_override(module_name = "webawt", path = "../java-awt-j2cl")
local_path_override(module_name = "javax-swing-j2cl", path = "../javax-swing-j2cl")

single_version_override(
    module_name = "elemental2",
    version = "1.3.2",
    patch_strip = 1,
    patches = ["//:third_party/webawt/elemental2-1.3.2-w3c-css.patch"],
)

# java.* sources are compiled once, into J2CL's java.base bootclasspath.
single_version_override(
    module_name = "j2cl",
    version = "20260402",
    patch_strip = 1,
    patches = [
        "//:third_party/j2cl/composed.patch",
        "//:third_party/j2cl/type-support/class-type-support.patch",
        "//:third_party/j2cl/swing-support/j2cl-invocation-support.patch",
        "//:third_party/j2cl/mps-support/classloader.patch",
        "//:third_party/j2cl/api-support/api-support.patch",
    ],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "jetbrains_annotations",
    urls = ["https://repo.maven.apache.org/maven2/org/jetbrains/annotations/26.0.2/annotations-26.0.2-sources.jar"],
    sha256 = "a3bea3ada0af186437f8f3a089e6b0f52ac5aa068c1cb829058fb8a5069f6b0f",
    type = "zip",
    build_file_content = """
load("@j2cl//build_defs:rules.bzl", "j2cl_library")
j2cl_library(
    name = "annotations",
    srcs = glob(
        ["org/jetbrains/annotations/**/*.java", "org/intellij/lang/annotations/**/*.java"],
        exclude = ["org/intellij/lang/annotations/JdkConstants.java"],
    ),
    visibility = ["//visibility:public"],
)
""",
)
