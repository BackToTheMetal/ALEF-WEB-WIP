--- /dev/null
+++ b/jre/java/java/lang/ref/Reference.java
@@ -0,0 +1,52 @@
+package java.lang.ref;
+
+import jsinterop.annotations.JsPackage;
+import jsinterop.annotations.JsType;
+
+/** Browser reference storage. Native object referents require JavaScript WeakRef. */
+public abstract class Reference<T> {
+  private NativeWeakRef<T> weak;
+  private T strong;
+  private boolean active;
+  private final ReferenceQueue<? super T> queue;
+  private boolean enqueued;
+  private boolean dequeued;
+
+  Reference(T referent, ReferenceQueue<? super T> queue, boolean retain) {
+    this.queue = queue;
+    if (retain || referent == null || referent instanceof String || referent instanceof Boolean || referent instanceof Double) {
+      strong = referent;
+    } else {
+      weak = new NativeWeakRef<>(referent);
+      active = true;
+    }
+    if (queue != null && active) queue.register(this);
+  }
+
+  public T get() { return peek(); }
+  final T peek() { return weak != null ? weak.deref() : strong; }
+  public final boolean refersTo(T object) { return peek() == object; }
+  public void clear() { weak = null; strong = null; active = false; }
+  public boolean isEnqueued() { return enqueued; }
+  public boolean enqueue() {
+    if (queue == null || enqueued || dequeued) return false;
+    clear();
+    enqueued = true;
+    queue.enqueueReference(this);
+    return true;
+  }
+  final boolean checkCollected() {
+    if (active && peek() == null) enqueue();
+    return !active;
+  }
+  final void dequeued() { enqueued = false; dequeued = true; }
+
+  /** JavaScript objects returned by WeakRef.deref remain alive through the current job. */
+  public static void reachabilityFence(Object ref) {}
+
+  @JsType(isNative = true, namespace = JsPackage.GLOBAL, name = "WeakRef")
+  static final class NativeWeakRef<T> {
+    NativeWeakRef(T value) {}
+    native T deref();
+  }
+}
diff --git a/jre/java/java/lang/ref/ReferenceQueue.java b/jre/java/java/lang/ref/ReferenceQueue.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/lang/ref/ReferenceQueue.java
@@ -0,0 +1,39 @@
+package java.lang.ref;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * A real pollable queue. Native weak references are checked when poll is called;
+ * collection is not simulated and never depends on a finalizer running.
+ * Blocking remove is unavailable on the browser event thread.
+ */
+public class ReferenceQueue<T> {
+  private final ArrayDeque<Reference<? extends T>> pending = new ArrayDeque<>();
+  private final List<Reference.NativeWeakRef<Reference<? extends T>>> watched = new ArrayList<>();
+
+  public ReferenceQueue() {}
+  @SuppressWarnings("unchecked")
+  void register(Reference<?> reference) {
+    watched.add(new Reference.NativeWeakRef<>((Reference<? extends T>) reference));
+  }
+  @SuppressWarnings("unchecked")
+  void enqueueReference(Reference<?> reference) { pending.add((Reference<? extends T>) reference); }
+  public Reference<? extends T> poll() {
+    for (int i = watched.size() - 1; i >= 0; i--) {
+      Reference<?> reference = watched.get(i).deref();
+      if (reference == null || reference.checkCollected()) watched.remove(i);
+    }
+    Reference<? extends T> reference = pending.poll();
+    if (reference != null) reference.dequeued();
+    return reference;
+  }
+  public Reference<? extends T> remove() throws InterruptedException { return remove(0); }
+  public Reference<? extends T> remove(long timeout) throws InterruptedException {
+    if (timeout < 0) throw new IllegalArgumentException("Negative timeout");
+    Reference<? extends T> ready = poll();
+    if (ready != null) return ready;
+    throw new UnsupportedOperationException("ReferenceQueue.remove cannot block the browser event thread; use poll");
+  }
+}
