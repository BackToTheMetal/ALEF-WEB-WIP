+    long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    int mp = (int) ((5 * doy + 2) / 153);
+    int date = (int) (doy - (153 * mp + 2) / 5 + 1);
+    int month = mp + (mp < 10 ? 3 : -9);
+    if (month <= 2) year++;
