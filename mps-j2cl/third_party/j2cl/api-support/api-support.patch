+          atom = prefix + expression(true) + ")";
+          nestedCaptures = groupCount - capturesBefore - (capturing ? 1 : 0);
+          nestedBoundaries = boundaryCount - boundariesBefore;
+        } else if (c == '[') {
+          atom = foldedClass(characterClass(false));
