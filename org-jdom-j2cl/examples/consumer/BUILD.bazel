load("@j2cl//build_defs:rules.bzl", "j2cl_application", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")
j2cl_library(
    name = "consumer",
    srcs = ["Consumer.java"],
    deps = ["@org_jdom_j2cl//:jdom", "@j2cl//:jsinterop-annotations-j2cl"],
)
closure_js_library(name = "app", srcs = ["app.js"], deps = [":consumer"])
j2cl_application(name = "browser", entry_points = ["example.app"], deps = [":app"])
