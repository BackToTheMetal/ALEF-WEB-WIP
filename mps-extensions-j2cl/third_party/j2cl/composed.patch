new file mode 100644
--- /dev/null
+++ b/jre/java/java/util/concurrent/CountDownLatch.java
@@ -0,0 +1,49 @@
+package java.util.concurrent;
+
+import java.util.Objects;
+
+/** A countdown whose already-completed waits succeed synchronously. */
+public class CountDownLatch {
+  private int count;
+
+  public CountDownLatch(int count) {
+    if (count < 0) {
+      throw new IllegalArgumentException("count < 0");
+    }
+    this.count = count;
+  }
+
+  public void await() throws InterruptedException {
+    checkInterrupted();
+    if (count != 0) {
+      throw new IllegalStateException("CountDownLatch.await cannot block the browser main thread");
+    }
+  }
+
+  public boolean await(long timeout, TimeUnit unit) throws InterruptedException {
+    Objects.requireNonNull(unit);
+    checkInterrupted();
+    return count == 0;
+  }
+
+  public void countDown() {
+    if (count != 0) {
+      count--;
+    }
+  }
+
+  public long getCount() {
+    return count;
+  }
+
+  private static void checkInterrupted() throws InterruptedException {
+    if (Thread.interrupted()) {
+      throw new InterruptedException();
+    }
+  }
+
+  @Override
+  public String toString() {
+    return super.toString() + "[Count = " + count + "]";
+  }
+}
diff --git a/jre/java/java/util/concurrent/CyclicBarrier.java b/jre/java/java/util/concurrent/CyclicBarrier.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/util/concurrent/CyclicBarrier.java
@@ -0,0 +1,94 @@
+package java.util.concurrent;
+
+import java.util.Objects;
+
+/**
+ * A one-party barrier runs its action inline on each arrival. A multi-party barrier
+ * cannot complete synchronously: an untimed arrival fails explicitly, a timed arrival
+ * times out immediately, and either failure breaks the generation until reset.
+ */
+public class CyclicBarrier {
+  private final int parties;
+  private final Runnable barrierAction;
+  private boolean broken;
+  private boolean runningAction;
+
+  public CyclicBarrier(int parties) {
+    this(parties, null);
+  }
+
+  public CyclicBarrier(int parties, Runnable barrierAction) {
+    if (parties <= 0) {
+      throw new IllegalArgumentException("parties must be positive");
+    }
+    this.parties = parties;
+    this.barrierAction = barrierAction;
+  }
+
+  public int getParties() {
+    return parties;
+  }
+
+  public int await() throws InterruptedException, BrokenBarrierException {
+    checkArrival();
+    if (parties != 1) {
+      broken = true;
+      throw new IllegalStateException("CyclicBarrier.await cannot block the browser main thread");
+    }
+    return runBarrierAction();
+  }
+
+  /** Insufficient arrivals time out immediately, irrespective of the supplied duration. */
+  public int await(long timeout, TimeUnit unit)
+      throws InterruptedException, BrokenBarrierException, TimeoutException {
+    Objects.requireNonNull(unit);
+    checkArrival();
+    if (parties != 1) {
+      broken = true;
+      throw new TimeoutException("CyclicBarrier cannot await other parties on the browser main thread");
+    }
+    return runBarrierAction();
+  }
+
+  public boolean isBroken() {
+    return broken;
+  }
+
+  /** Starts a fresh generation; no tasks are blocked or resumed by this operation. */
+  public void reset() {
+    broken = false;
+  }
+
+  public int getNumberWaiting() {
+    return runningAction ? 1 : 0;
+  }
+
+  private void checkArrival() throws InterruptedException, BrokenBarrierException {
+    if (broken) {
+      throw new BrokenBarrierException();
+    }
+    if (Thread.interrupted()) {
+      broken = true;
+      throw new InterruptedException();
+    }
+    if (runningAction) {
+      broken = true;
+      throw new IllegalStateException("A barrier action cannot reenter its own barrier");
+    }
+  }
+
+  private int runBarrierAction() {
+    runningAction = true;
+    try {
+      if (barrierAction != null) {
+        barrierAction.run();
+      }
+      return 0;
+    } catch (RuntimeException | Error failure) {
+      broken = true;
+      throw failure;
+    } finally {
+      runningAction = false;
+    }
+  }
+}
diff --git a/jre/java/java/util/concurrent/DelayQueue.java b/jre/java/java/util/concurrent/DelayQueue.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/util/concurrent/DelayQueue.java
@@ -0,0 +1,162 @@
+package java.util.concurrent;
+
+import java.util.AbstractQueue;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Iterator;
+import java.util.Objects;
+import java.util.PriorityQueue;
+
+/**
+ * Priority-ordered delayed elements using only Java state. Expiry is read from each
+ * element's getDelay method; this queue neither advances a clock nor schedules a callback.
+ */
+public class DelayQueue<E extends Delayed> extends AbstractQueue<E> implements BlockingQueue<E> {
+  private final PriorityQueue<E> data = new PriorityQueue<>();
+
+  public DelayQueue() {}
+
+  public DelayQueue(Collection<? extends E> collection) {
+    addAll(collection);
+  }
+
+  @Override
+  public boolean offer(E element) {
+    return data.offer(Objects.requireNonNull(element));
+  }
+
+  /** An unbounded insertion executes immediately and does not consume interruption. */
+  @Override
+  public void put(E element) {
+    offer(element);
+  }
+
+  /** Capacity never requires a wait; the timeout has no scheduling effect. */
+  @Override
+  public boolean offer(E element, long timeout, TimeUnit unit) {
+    Objects.requireNonNull(unit);
+    return offer(element);
+  }
+
+  /** Returns and removes the first element only when its delay is nonpositive. */
+  @Override
+  public E poll() {
+    E first = data.peek();
+    return first == null || first.getDelay(TimeUnit.NANOSECONDS) > 0 ? null : data.poll();
+  }
+
+  /** An empty queue or an unexpired head cannot suspend the browser main thread. */
+  @Override
+  public E take() throws InterruptedException {
+    checkInterrupted();
+    E element = poll();
+    if (element == null) {
+      throw new IllegalStateException("DelayQueue.take cannot block the browser main thread");
+    }
+    return element;
+  }
+
+  /** A failed timed wait returns null immediately, without removing unexpired data. */
+  @Override
+  public E poll(long timeout, TimeUnit unit) throws InterruptedException {
+    Objects.requireNonNull(unit);
+    checkInterrupted();
+    return poll();
+  }
+
+  /** Peeking exposes the first element even when it has not expired. */
+  @Override
+  public E peek() {
+    return data.peek();
+  }
+
+  @Override
+  public int size() {
+    return data.size();
+  }
+
+  @Override
+  public int remainingCapacity() {
+    return Integer.MAX_VALUE;
+  }
+
+  @Override
+  public int drainTo(Collection<? super E> collection) {
+    return drainTo(collection, Integer.MAX_VALUE);
+  }
+
+  /** Transfers only expired elements, preserving each item if destination.add throws. */
+  @Override
+  public int drainTo(Collection<? super E> collection, int maxElements) {
+    Objects.requireNonNull(collection);
+    if (collection == this) {
+      throw new IllegalArgumentException("Cannot drain a queue to itself");
+    }
+    int transferred = 0;
+    while (transferred < maxElements) {
+      E first = data.peek();
+      if (first == null || first.getDelay(TimeUnit.NANOSECONDS) > 0) {
+        break;
+      }
+      collection.add(first);
+      data.poll();
+      transferred++;
+    }
+    return transferred;
+  }
+
+  @Override
+  public boolean remove(Object object) {
+    return data.remove(object);
+  }
+
+  @Override
+  public boolean contains(Object object) {
+    return data.contains(object);
+  }
+
+  @Override
+  public void clear() {
+    data.clear();
+  }
+
+  /** Snapshot traversal is unordered; iterator removal targets the returned object identity. */
+  @Override
+  public Iterator<E> iterator() {
+    Iterator<E> snapshot = new ArrayList<>(data).iterator();
+    return new Iterator<E>() {
+      private E returned;
+
+      @Override
+      public boolean hasNext() {
+        return snapshot.hasNext();
+      }
+
+      @Override
+      public E next() {
+        returned = snapshot.next();
+        return returned;
+      }
+
+      @Override
+      public void remove() {
+        if (returned == null) {
+          throw new IllegalStateException();
+        }
+        for (Iterator<E> live = data.iterator(); live.hasNext(); ) {
+          if (live.next() == returned) {
+            live.remove();
+            break;
+          }
+        }
+        returned = null;
+      }
+    };
+  }
+
+  private static void checkInterrupted() throws InterruptedException {
+    if (Thread.interrupted()) {
+      throw new InterruptedException();
+    }
+  }
+}
diff --git a/jre/java/java/util/concurrent/ExecutorCompletionService.java b/jre/java/java/util/concurrent/ExecutorCompletionService.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/util/concurrent/ExecutorCompletionService.java
@@ -0,0 +1,22 @@
+package java.util.concurrent;
+
+import java.util.Objects;
+
+public class ExecutorCompletionService<V> implements CompletionService<V> {
+  private final Executor executor;
+  private final BlockingQueue<Future<V>> completed;
+  public ExecutorCompletionService(Executor executor) { this(executor, new LinkedBlockingQueue<>()); }
+  public ExecutorCompletionService(Executor executor, BlockingQueue<Future<V>> queue) {
+    this.executor = Objects.requireNonNull(executor); completed = Objects.requireNonNull(queue);
+  }
+  @Override public Future<V> submit(Callable<V> task) {
+    FutureTask<V> future = new FutureTask<V>(task) {
+      @Override protected void done() { completed.add(this); }
+    };
+    executor.execute(future); return future;
+  }
+  @Override public Future<V> submit(Runnable task, V result) { return submit(Executors.callable(task, result)); }
+  @Override public Future<V> take() throws InterruptedException { return completed.take(); }
+  @Override public Future<V> poll() { return completed.poll(); }
+  @Override public Future<V> poll(long timeout, TimeUnit unit) throws InterruptedException { return completed.poll(timeout, unit); }
+}
