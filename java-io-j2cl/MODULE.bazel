module(
    name = "java_io_j2cl",
    version = "0.1.0",
)

bazel_dep(name = "j2cl", version = "20260402")
bazel_dep(name = "rules_closure", version = "0.16.0")

# java.io belongs to J2CL's java.base module. Missing classes must be compiled
# into the JRE itself; a second ordinary j2cl_library cannot safely own them.
single_version_override(
    module_name = "j2cl",
    patch_strip = 1,
    patches = ["//third_party/patches:j2cl-java-io.patch"],
    version = "20260402",
)
