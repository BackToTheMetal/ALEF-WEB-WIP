diff --git a/jre/java/java/io/BufferedReader.java b/jre/java/java/io/BufferedReader.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/io/BufferedReader.java
@@ -0,0 +1,132 @@
+package java.io;
+
+/** Reader wrapper with line handling and delegated mark/reset behavior. */
+public class BufferedReader extends Reader {
+  private final Reader input;
+  private int pending = -1;
+  private int markedPending = -1;
+  private boolean closed;
+
+  public BufferedReader(Reader input, int size) {
+    if (input == null) {
+      throw new NullPointerException("input");
+    }
+    if (size <= 0) {
+      throw new IllegalArgumentException("Buffer size <= 0");
+    }
+    this.input = input;
+  }
+
+  public BufferedReader(Reader input) {
+    this(input, 8192);
+  }
+
+  private void ensureOpen() throws IOException {
+    if (closed) {
+      throw new IOException("Stream closed");
+    }
+  }
+
+  @Override
+  public int read() throws IOException {
+    ensureOpen();
+    if (pending != -1) {
+      int value = pending;
+      pending = -1;
+      return value;
+    }
+    return input.read();
+  }
+
+  @Override
+  public int read(char[] buffer, int offset, int length) throws IOException {
+    ensureOpen();
+    if (buffer == null) {
+      throw new NullPointerException("buffer");
+    }
+    if (offset < 0 || length < 0 || offset > buffer.length - length) {
+      throw new IndexOutOfBoundsException();
+    }
+    if (length == 0) {
+      return 0;
+    }
+    int count = 0;
+    if (pending != -1) {
+      buffer[offset++] = (char) pending;
+      pending = -1;
+      length--;
+      count++;
+    }
+    if (length == 0) {
+      return count;
+    }
+    int read = input.read(buffer, offset, length);
+    return read == -1 ? (count == 0 ? -1 : count) : count + read;
+  }
+
+  public String readLine() throws IOException {
+    ensureOpen();
+    StringBuilder line = new StringBuilder();
+    int value;
+    while ((value = read()) != -1) {
+      if (value == '\n') {
+        break;
+      }
+      if (value == '\r') {
+        int next = read();
+        if (next != '\n' && next != -1) {
+          pending = next;
+        }
+        break;
+      }
+      line.append((char) value);
+    }
+    return value == -1 && line.length() == 0 ? null : line.toString();
+  }
+
+  @Override
+  public long skip(long count) throws IOException {
+    ensureOpen();
+    if (count < 0) {
+      throw new IllegalArgumentException("skip value is negative");
+    }
+    long skipped = 0;
+    while (skipped < count && read() != -1) {
+      skipped++;
+    }
+    return skipped;
+  }
+
+  @Override
+  public boolean ready() throws IOException {
+    ensureOpen();
+    return pending != -1 || input.ready();
+  }
+
+  @Override
+  public boolean markSupported() {
+    return input.markSupported();
+  }
+
+  @Override
+  public void mark(int readAheadLimit) throws IOException {
+    ensureOpen();
+    input.mark(readAheadLimit);
+    markedPending = pending;
+  }
+
+  @Override
+  public void reset() throws IOException {
+    ensureOpen();
+    input.reset();
+    pending = markedPending;
+  }
+
+  @Override
+  public void close() throws IOException {
+    if (!closed) {
+      closed = true;
+      input.close();
+    }
+  }
+}
diff --git a/jre/java/java/io/CharArrayReader.java b/jre/java/java/io/CharArrayReader.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/io/CharArrayReader.java
@@ -0,0 +1,100 @@
+package java.io;
+
+/** In-memory character reader. */
+public class CharArrayReader extends Reader {
+  protected char[] buf;
+  protected int pos;
+  protected int markedPos;
+  protected int count;
+
+  public CharArrayReader(char[] buffer) {
+    this(buffer, 0, buffer.length);
+  }
+
+  public CharArrayReader(char[] buffer, int offset, int length) {
+    if (buffer == null) {
+      throw new NullPointerException("buffer");
+    }
+    if (offset < 0 || length < 0 || offset > buffer.length - length) {
+      throw new IllegalArgumentException();
+    }
+    buf = buffer;
+    pos = offset;
+    markedPos = offset;
+    count = Math.min(offset + length, buffer.length);
+  }
+
+  private void ensureOpen() throws IOException {
+    if (buf == null) {
+      throw new IOException("Stream closed");
+    }
+  }
+
+  @Override
+  public int read() throws IOException {
+    ensureOpen();
+    return pos >= count ? -1 : buf[pos++];
+  }
+
+  @Override
+  public int read(char[] buffer, int offset, int length) throws IOException {
+    ensureOpen();
+    if (buffer == null) {
+      throw new NullPointerException("buffer");
+    }
+    if (offset < 0 || length < 0 || offset > buffer.length - length) {
+      throw new IndexOutOfBoundsException();
+    }
+    if (length == 0) {
+      return 0;
+    }
+    if (pos >= count) {
+      return -1;
+    }
+    int actual = Math.min(length, count - pos);
+    for (int i = 0; i < actual; i++) {
+      buffer[offset + i] = buf[pos + i];
+    }
+    pos += actual;
+    return actual;
+  }
+
+  @Override
+  public long skip(long amount) throws IOException {
+    ensureOpen();
+    if (amount <= 0) {
+      return 0;
+    }
+    int actual = (int) Math.min(amount, count - pos);
+    pos += actual;
+    return actual;
+  }
+
+  @Override
+  public boolean ready() throws IOException {
+    ensureOpen();
+    return pos < count;
+  }
+
+  @Override
+  public boolean markSupported() {
+    return true;
+  }
+
+  @Override
+  public void mark(int readAheadLimit) throws IOException {
+    ensureOpen();
+    markedPos = pos;
+  }
+
+  @Override
+  public void reset() throws IOException {
+    ensureOpen();
+    pos = markedPos;
+  }
+
+  @Override
+  public void close() {
+    buf = null;
+  }
+}
diff --git a/jre/java/java/io/CharArrayWriter.java b/jre/java/java/io/CharArrayWriter.java
new file mode 100644
--- /dev/null
+++ b/jre/java/java/io/CharArrayWriter.java
@@ -0,0 +1,97 @@
+package java.io;
+
+/** Growable in-memory character writer. */
+public class CharArrayWriter extends Writer {
+  protected char[] buf;
+  protected int count;
+
+  public CharArrayWriter() {
+    this(32);
+  }
+
+  public CharArrayWriter(int initialSize) {
+    if (initialSize < 0) {
+      throw new IllegalArgumentException("Negative initial size: " + initialSize);
+    }
+    buf = new char[initialSize];
+  }
+
+  private void ensureCapacity(int minimum) {
+    if (minimum <= buf.length) {
+      return;
+    }
+    int nextLength = Math.max(minimum, Math.max(1, buf.length * 2));
+    char[] next = new char[nextLength];
+    for (int i = 0; i < count; i++) {
+      next[i] = buf[i];
+    }
+    buf = next;
+  }
+
+  @Override
+  public void write(int value) {
+    ensureCapacity(count + 1);
+    buf[count++] = (char) value;
+  }
+
+  @Override
+  public void write(char[] source, int offset, int length) {
+    if (source == null) {
+      throw new NullPointerException("source");
+    }
+    if (offset < 0 || length < 0 || offset > source.length - length) {
+      throw new IndexOutOfBoundsException();
+    }
+    ensureCapacity(count + length);
+    for (int i = 0; i < length; i++) {
+      buf[count + i] = source[offset + i];
+    }
+    count += length;
+  }
+
+  @Override
+  public void write(String value, int offset, int length) {
+    if (value == null) {
+      throw new NullPointerException("value");
+    }
+    if (offset < 0 || length < 0 || offset > value.length() - length) {
+      throw new IndexOutOfBoundsException();
+    }
+    ensureCapacity(count + length);
+    for (int i = 0; i < length; i++) {
+      buf[count + i] = value.charAt(offset + i);
+    }
+    count += length;
+  }
+
+  public void writeTo(Writer output) throws IOException {
+    output.write(buf, 0, count);
+  }
+
+  public void reset() {
+    count = 0;
+  }
+
+  public char[] toCharArray() {
+    char[] result = new char[count];
+    for (int i = 0; i < count; i++) {
+      result[i] = buf[i];
+    }
+    return result;
+  }
+
+  public int size() {
+    return count;
+  }
+
+  @Override
+  public String toString() {
+    return new String(buf, 0, count);
+  }
+
+  @Override
+  public void flush() {}
+
+  @Override
+  public void close() {}
+}
