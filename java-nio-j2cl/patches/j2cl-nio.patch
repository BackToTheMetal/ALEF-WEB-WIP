+  public boolean isUnderflow() { return kind == 0; }
+  public boolean isOverflow() { return kind == 1; }
+  public boolean isError() { return kind >= 2; }
+  public boolean isMalformed() { return kind == 2; }
+  public boolean isUnmappable() { return kind == 3; }
