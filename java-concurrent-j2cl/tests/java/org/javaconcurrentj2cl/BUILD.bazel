load("@j2cl//build_defs:rules.bzl", "j2cl_application", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")

j2cl_library(
    name = "probe",
    srcs = glob(["*.java"]),
    deps = ["//tests/mps:mps-cache", "@j2cl//:jsinterop-annotations-j2cl"],
)

closure_js_library(
    name = "externs",
    srcs = ["externs.js"],
)

closure_js_library(
    name = "entry",
    srcs = ["entry.js"],
    deps = [":probe", ":externs"],
)

j2cl_application(
    name = "application",
    entry_points = ["concurrent.probe"],
    deps = [":entry"],
)
